# BioRAG Bench Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: OpenAI API Key
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================
# LLM model for generation (default: gpt-4o-mini)
# BIORAG_LLM_MODEL=gpt-4o-mini

# Embedding model (default: text-embedding-3-large)
# BIORAG_EMBEDDING_MODEL=text-embedding-3-large

# =============================================================================
# OPTIONAL: Cost Controls
# =============================================================================
# Maximum number of questions to evaluate (default: unlimited)
# BIORAG_MAX_QUESTIONS=100

# Maximum total tokens for a run (default: unlimited)
# BIORAG_MAX_TOTAL_TOKENS=1000000

# Maximum USD budget for a run (default: unlimited)
# BIORAG_MAX_USD=10.0

# =============================================================================
# OPTIONAL: Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# BIORAG_LOG_LEVEL=INFO

# Enable JSON structured logging (default: false)
# BIORAG_JSON_LOGS=false

# =============================================================================
# OPTIONAL: Paths
# =============================================================================
# Data directory (default: ./data)
# BIORAG_DATA_DIR=./data

# Runs output directory (default: ./runs)
# BIORAG_RUNS_DIR=./runs

# Cache directory (default: ./data/cache)
# BIORAG_CACHE_DIR=./data/cache

# =============================================================================
# OPTIONAL: HuggingFace
# =============================================================================
# HuggingFace token (for private datasets or increased rate limits)
# HF_TOKEN=hf_your-token-here

# =============================================================================
# OPTIONAL: API Server
# =============================================================================
# API host (default: 0.0.0.0)
# BIORAG_API_HOST=0.0.0.0

# API port (default: 8000)
# BIORAG_API_PORT=8000

